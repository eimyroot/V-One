VOODOO_ENV=local
VOODOO_ROOT=/app
VOODOO_DATABASE_BACKEND=sqlite
VOODOO_PRODUCT_DB=/app/storage/product/voodoo_one.sqlite3
VOODOO_PRODUCT_SANDBOX_ROOT=/app/storage/product/sandboxes
VOODOO_IDENTITY_PROVIDER=local
# OIDC remains unreleased and selecting it aborts startup before database initialization.
# VOODOO_OIDC_ISSUER=https://identity.example.com/tenant
# VOODOO_OIDC_AUDIENCE=voodoo-one
# VOODOO_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# VOODOO_OIDC_SUBJECT_CLAIM=sub
# VOODOO_OIDC_USERNAME_CLAIM=preferred_username
# VOODOO_OIDC_GROUPS_CLAIM=groups
VOODOO_SESSION_SIGNING_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
VOODOO_BOOTSTRAP_TOKEN=GENERATE_AT_LEAST_24_RANDOM_BYTES
VOODOO_TOKEN_TTL_SECONDS=3600
VOODOO_AUTH_MAX_FAILURES=5
VOODOO_AUTH_SOURCE_MAX_FAILURES=20
VOODOO_AUTH_WINDOW_SECONDS=300
VOODOO_AUTH_LOCKOUT_SECONDS=900
VOODOO_EXECUTION_TIMEOUT_SECONDS=120
VOODOO_EXECUTION_LEASE_SECONDS=180
VOODOO_LOG_LEVEL=INFO
VOODOO_ALLOW_PRODUCTION_EFFECTS=false
VOODOO_ENABLE_APPROVAL_POLICY_COMPATIBILITY=false
VOODOO_CORS_ORIGINS=
VOODOO_TRUSTED_HOSTS=localhost,127.0.0.1
