#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PYTHON="$ROOT/.venv/bin/python"

if [ ! -x "$PYTHON" ]; then
  printf 'voodoo: repository Python runtime is not executable: %s\n' "$PYTHON" >&2
  printf '%s\n' 'voodoo: create the repository .venv before using this local command.' >&2
  exit 127
fi

PYTHONPATH="$ROOT"
export PYTHONPATH

exec "$PYTHON" -m voodoo_product "$@"
