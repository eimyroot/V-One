{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-one.dev/schemas/vop/registry.v1.json",
  "schema_version": 1,
  "kind": "vop-schema-registry/v1",
  "vocabulary_type": "vop-canonical-vocabulary/v1",
  "status": "RESERVED_IDS",
  "canonical_schema_ids": [
    "operation-request/v1",
    "reviewed-operation/v1",
    "capability-definition/v1",
    "execution-target/v1",
    "policy-revision/v1",
    "approval-certificate/v1",
    "authority-witness-set/v1",
    "authorization-snapshot/v1",
    "execution-grant/v1",
    "execution-capsule/v1",
    "dispatch-envelope/v1",
    "execution-receipt/v1",
    "verification-result/v1",
    "operation-proof/v1"
  ],
  "identity_grammar": [
    "logical_identity",
    "content_identity",
    "instance_id",
    "schema_version",
    "producer",
    "created_at",
    "causation_id",
    "correlation_id"
  ],
  "activation_rule": "A reserved schema ID becomes an implemented schema only when its concrete contract, semantic invariants, canonical serialization, and conformance tests exist in the repository.",
  "authority_rule": "Registry presence reserves semantic identity; it does not create runtime authorization, implementation, release, deployment, or production authority."
}
